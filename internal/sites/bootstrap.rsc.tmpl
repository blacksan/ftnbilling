# Fast Tech Net: bootstrap script for {{rq .SiteName}} ({{.SiteID}}), generated {{.Generated}}
# Builds this router from nothing: WAN, admin LAN, customer network, DHCP,
# firewall, services, the WireGuard tunnel to the billing server and the API
# user. Single use. It holds this router's WireGuard private key and API
# password, so keep it private. It removes itself from the router when it
# finishes, and also when it stops on an error (the whole body is wrapped).
# Every object it creates has a comment that starts with "ftn:"; running it
# again replaces them. It never prints a secret.
:local fails 0
:local abort ""
:local report ""
:local ver ""
:local result "fail"
:do {

:put "ftn 0/12: waiting for the ports, checking the router"
{{secOpen 0 "wait and guard" true}}
  :set ver [/system/resource/get version]
  :put ("   RouterOS " . $ver)
  :local major [:tonum [:pick $ver 0 [:find $ver "."]]]
  :if ($major < 7) do={ :error "RouterOS 7 or newer is required" }
  :local need {{.NeedPorts}}
  :local waited 0
  :local ready false
  :local missing ""
  :while (!$ready && $waited <= 60) do={
    :set ready true
    :set missing ""
    :foreach n in=$need do={
      :if ([:len [/interface/find where name=$n]] = 0) do={ :set ready false; :set missing ($missing . " " . $n) }
    }
    :if (!$ready) do={ :delay 2s; :set waited ($waited + 2) }
  }
  :if (!$ready) do={ :error ("these ports do not exist on the router:" . $missing . ". Fix the port names in the billing admin") }
  # Foreign settings: this script may only replace what it made itself. (After the reset of the paste line the
  # router is empty and nothing is found.)
  :local foreign ""
  :foreach i in=[/ip/address/find where dynamic=no] do={ :if (!([/ip/address/get $i comment] ~ "^ftn:")) do={ :set foreign ($foreign . " address " . [/ip/address/get $i address] . ";") } }
  :foreach i in=[/interface/bridge/find] do={ :if (!([/interface/bridge/get $i comment] ~ "^ftn:")) do={ :set foreign ($foreign . " bridge " . [/interface/bridge/get $i name] . ";") } }
  :foreach i in=[/ip/dhcp-server/find] do={ :if (!([/ip/dhcp-server/get $i comment] ~ "^ftn:")) do={ :set foreign ($foreign . " dhcp-server " . [/ip/dhcp-server/get $i name] . ";") } }
  :foreach i in=[/ip/firewall/filter/find where dynamic=no] do={ :if (!([/ip/firewall/filter/get $i comment] ~ "^ftn:")) do={ :set foreign ($foreign . " firewall rule;") } }
  :foreach i in=[/ip/firewall/nat/find where dynamic=no] do={ :if (!([/ip/firewall/nat/get $i comment] ~ "^ftn:")) do={ :set foreign ($foreign . " nat rule;") } }
  :if ([:len $foreign] > 0) do={ :error ("this router already has settings that are not ours:" . $foreign . " Nothing was changed. Use the paste line from the billing admin (it erases the router first)") }
{{secClose 0 "wait and guard" true}}

:put "ftn 1/12: name, clock, trust anchors"
{{secOpen 1 "system" false}}
  /system/identity set name="{{rq .Identity}}"
  /system/clock set time-zone-name=Africa/Nairobi
  /system/ntp/client set enabled=yes servers=162.159.200.1,162.159.200.123
  :do { /certificate/settings set builtin-trust-anchors=trusted } on-error={ :put "   (this RouterOS has no built-in trust anchors setting)" }
{{secClose 1 "system" false}}

:put "ftn 2/12: WAN {{.WANIface}} ({{.WANMode}})"
{{secOpen 2 "lists and WAN" true}}
  :if ([:len [/interface/list/find where name="WAN"]] = 0) do={ /interface/list add name=WAN comment="ftn: WAN list" }
  :if ([:len [/interface/list/find where name="LAN"]] = 0) do={ /interface/list add name=LAN comment="ftn: LAN list" }
  /ip/dhcp-client remove [find where comment~"^ftn:"]
  /ip/dhcp-client remove [find where interface="{{.WANIface}}"]
  /interface/pppoe-client remove [find where comment~"^ftn:"]
  /ip/address remove [find where comment="ftn: WAN address"]
  /ip/route remove [find where comment="ftn: WAN default route"]
  /interface/list/member remove [find where list="WAN" and interface="{{.WANIface}}"]
{{- if eq .WANMode "dhcp"}}
  /ip/dhcp-client add interface={{.WANIface}} use-peer-dns=no add-default-route=yes disabled=no comment="ftn: WAN dhcp"
{{- else if eq .WANMode "static"}}
  /ip/address add address={{.WANAddress}} interface={{.WANIface}} comment="ftn: WAN address"
  /ip/route add dst-address=0.0.0.0/0 gateway={{.WANGateway}} comment="ftn: WAN default route"
{{- else if eq .WANMode "pppoe"}}
  /interface/list/member remove [find where list="WAN" and interface="{{.PPPoEIface}}"]
  /interface/pppoe-client add name={{.PPPoEIface}} interface={{.WANIface}} user="{{rq .PPPoEUser}}" password="{{rq .PPPoEPass}}" add-default-route=yes use-peer-dns=no disabled=no comment="ftn: WAN pppoe"
  /interface/list/member add list=WAN interface={{.PPPoEIface}} comment="ftn: WAN member"
{{- end}}
  /interface/list/member add list=WAN interface={{.WANIface}} comment="ftn: WAN member"
{{secClose 2 "lists and WAN" true}}

:put "ftn 3/12: admin LAN {{.LAN.Network}} on{{range .LANPorts}} {{.}}{{end}}"
{{secOpen 3 "admin LAN" true}}
  /ip/dhcp-server remove [find where name="ftn-lan-dhcp"]
  /ip/dhcp-server/network remove [find where comment="ftn: LAN DHCP network"]
  /ip/pool remove [find where name="ftn-lan-pool"]
  /ip/address remove [find where comment="ftn: LAN gateway"]
  /interface/bridge/port remove [find where comment="ftn: LAN port"]
  /interface/list/member remove [find where list="LAN" and interface="{{.LANBridge}}"]
  /interface/bridge remove [find where name="{{.LANBridge}}"]
  /interface/bridge add name={{.LANBridge}} comment="ftn: admin LAN bridge"
{{- range .LANPorts}}
  /interface/bridge/port remove [find where interface="{{.}}"]
  /interface/bridge/port add bridge={{$.LANBridge}} interface={{.}} comment="ftn: LAN port"
{{- end}}
  /ip/address add address={{.LAN.GatewayCIDR}} interface={{.LANBridge}} comment="ftn: LAN gateway"
  /ip/pool add name=ftn-lan-pool ranges={{.LAN.PoolFrom}}-{{.LAN.PoolTo}} comment="ftn: LAN pool"
  /ip/dhcp-server add name=ftn-lan-dhcp interface={{.LANBridge}} address-pool=ftn-lan-pool lease-time=1h disabled=no comment="ftn: LAN DHCP"
  /ip/dhcp-server/network add address={{.LAN.Network}} gateway={{.LAN.Gateway}} dns-server={{.LAN.Gateway}} comment="ftn: LAN DHCP network"
  /interface/list/member add list=LAN interface={{.LANBridge}} comment="ftn: LAN member"
{{secClose 3 "admin LAN" true}}

:put "ftn 4/12: customer network {{.Plan.Network}}"
{{secOpen 4 "customer network" true}}
  /ip/dhcp-server remove [find where name="{{.DHCPServer}}"]
  /ip/address remove [find where comment="ftn: customer gateway"]
  /interface/bridge/port remove [find where comment~"^ftn: (customer|bench) port"]
  /interface/bridge remove [find where name="{{.CustBridge}}"]
{{- if .VLANID}}
  /interface/vlan remove [find where name="{{.VLANName}}"]
  /interface/bridge/port remove [find where interface="{{.OLTInterface}}"]
  /interface/vlan add name={{.VLANName}} vlan-id={{.VLANID}} interface={{.OLTInterface}} comment="ftn: customer VLAN"
{{- else}}
  /interface/bridge/port remove [find where interface="{{.OLTInterface}}"]
{{- end}}
  /interface/bridge add name={{.CustBridge}} arp=reply-only comment="ftn: customer bridge"
  /interface/bridge/port add bridge={{.CustBridge}} interface={{.CustIface}} horizon=1 comment="ftn: customer port"
{{- if .BenchPort}}
  /interface/bridge/port remove [find where interface="{{.BenchPort}}"]
  /interface/bridge/port add bridge={{.CustBridge}} interface={{.BenchPort}} horizon=1 comment="ftn: bench port"
{{- end}}
  /ip/address add address={{.Plan.GatewayIP}} interface={{.CustBridge}} comment="ftn: customer gateway"
{{secClose 4 "customer network" true}}

:put "ftn 5/12: DHCP for the customers (unregistered .10-.59, flats get fixed addresses from the server)"
{{secOpen 5 "DHCP" true}}
  /ip/dhcp-server/network remove [find where comment="ftn: customer DHCP network"]
  /ip/pool remove [find where name="{{.UnregPool}}"]
  /ip/firewall/address-list remove [find where list="{{.UnregList}}" and comment="ftn: unregistered range"]
  /ip/pool add name={{.UnregPool}} ranges={{.Plan.UnregFrom}}-{{.Plan.UnregTo}} comment="ftn: unregistered pool"
  /ip/dhcp-server add name={{.DHCPServer}} interface={{.CustBridge}} address-pool={{.UnregPool}} lease-time=1m authoritative=yes add-arp=yes disabled=no comment="ftn: IPoE DHCP"
  /ip/dhcp-server/network add address={{.Plan.Network}} gateway={{.Plan.Gateway}} dns-server={{.Plan.Gateway}} comment="ftn: customer DHCP network"
  /ip/firewall/address-list add list={{.UnregList}} address={{.Plan.UnregFrom}}-{{.Plan.UnregTo}} comment="ftn: unregistered range"
{{secClose 5 "DHCP" true}}

:put "ftn 6/12: firewall (nothing is opened on the WAN)"
{{secOpen 6 "firewall" true}}
  /ip/firewall/filter remove [find where comment~"^ftn:"]
  /ip/firewall/nat remove [find where comment~"^ftn:"]
{{- range .Filter}}
{{.}}
{{- end}}
{{- range .NAT}}
{{.}}
{{- end}}
{{secClose 6 "firewall" true}}

:put "ftn 7/12: DNS and IPv6"
{{secOpen 7 "DNS and IPv6" false}}
  /ip/dns set servers={{.DNSServers}} allow-remote-requests=yes
  /ipv6/settings set disable-ipv6=yes
  :do {
    /ipv6/firewall/filter remove [find where comment~"^ftn:"]
    /ipv6/firewall/filter add chain=forward action=drop in-interface={{.CustBridge}} comment="ftn: ipv6 drop"
  } on-error={ :put "   (no IPv6 firewall on this router)" }
{{secClose 7 "DNS and IPv6" false}}

:put "ftn 8/12: services"
{{secOpen 8 "services" false}}
  /ip/service set telnet disabled=yes
  /ip/service set ftp disabled=yes
  /ip/service set api disabled=yes
  /ip/service set api-ssl disabled=yes
  /ip/service set www-ssl disabled=yes
  /ip/service set www port={{.RESTPort}} address={{.ServerIP}}/32 disabled=no
  /ip/service set ssh address={{.LAN.Network}} disabled=no
  /ip/service set winbox address={{.LAN.Network}} disabled=no
  :if ([:len [/interface/list/member/find where list="LAN"]] > 0) do={
    /tool/mac-server set allowed-interface-list=LAN
    /tool/mac-server/mac-winbox set allowed-interface-list=LAN
    /ip/neighbor/discovery-settings set discover-interface-list=LAN
  }
  /tool/bandwidth-server set enabled=no
{{secClose 8 "services" false}}

:put "ftn 9/12: WireGuard tunnel to the billing server"
{{secOpen 9 "WireGuard" true}}
  /interface/wireguard remove [find where name="{{.WGIface}}"]
  /interface/wireguard add name={{.WGIface}} private-key="{{.PrivateKey}}" mtu={{.MTU}} comment="ftn: tunnel to the billing server"
  /ip/address remove [find where comment="ftn: tunnel address"]
  /ip/address add address={{.TunnelIP}} network={{.ServerIP}} interface={{.WGIface}} comment="ftn: tunnel address"
  /interface/wireguard/peers remove [find where comment="ftn: billing server"]
  /interface/wireguard/peers add interface={{.WGIface}} public-key="{{.ServerPublicKey}}" endpoint-address={{.EndpointHost}} endpoint-port={{.EndpointPort}} allowed-address={{.ServerIP}}/32 persistent-keepalive=25s comment="ftn: billing server"
{{secClose 9 "WireGuard" true}}

:put "ftn 10/12: API user for the billing server"
{{secOpen 10 "REST user" true}}
  /user remove [find where name="ispbill"]
  /user remove [find where name="{{.RESTUser}}"]
  /user/group remove [find where name="ispbill"]
  /user/group remove [find where name="{{.RESTUser}}"]
  /user/group add name={{.RESTUser}} policy=read,write,test,sensitive,api,rest-api,reboot comment="ftn: billing API"
  /user add name={{.RESTUser}} group={{.RESTUser}} password="{{rq .RESTPass}}" address={{.ServerIP}}/32 comment="ftn: billing API"
{{secClose 10 "REST user" true}}
{{if .NetflowPort}}
:put "ftn 11/12: traffic reporting"
{{secOpen 11 "traffic-flow" false}}
  /ip/traffic-flow/target remove [find where comment="ftn: netflow"]
  /ip/traffic-flow set enabled=yes interfaces={{.CustBridge}}
  /ip/traffic-flow/target add dst-address={{.ServerIP}} port={{.NetflowPort}} version=5 comment="ftn: netflow"
{{secClose 11 "traffic-flow" false}}
{{else}}
:put "ftn 11/12: traffic reporting is off on the server"
{{end}}
:put "ftn 12/12: checking the internet and the billing server"
:local w 0
:while ([:len [/ip/route/find where dst-address="0.0.0.0/0" and active=yes]] = 0 && $w < 30) do={ :delay 1s; :set w ($w + 1) }
:if ([:len [/ip/route/find where dst-address="0.0.0.0/0" and active=yes]] = 0) do={ :set report ($report . "12 internet: the router has no default route (check the WAN settings)\n"); :set fails ($fails + 1); :put "   no default route yet" }
:local pr 0
:do { :set pr [/ping {{.ServerIP}} count=3] } on-error={}
:if ($pr = 0) do={ :put "   no answer from the billing server yet; the tunnel can take a few seconds to come up" } else={ :put ("   billing server: " . $pr . " of 3 replies") }
:log info "ftn: bootstrap finished"
:if ($fails > 0) do={ :put ("ftn: finished with " . $fails . " section(s) failed, see the messages above") } else={ :put "ftn: all sections done"; :set result "ok" }
:if ([:len $report] > 0) do={ :put "ftn: problems:"; :put $report }
{{.ReportPost}}
} on-error={
  :put "ftn: the bootstrap script stopped early, see below"
  :if ([:len $abort] > 0) do={ :put $abort }
  {{.ReportPost}}
{{- range .Files}}
  /file remove [find where name="{{.}}"]
{{- end}}
  :error "ftn: bootstrap stopped; the script files were removed from the router. Fix the cause, then make a new line"
}
{{- range .Files}}
/file remove [find where name="{{.}}"]
{{- end}}
