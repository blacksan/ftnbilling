# Fast Tech Net: switch this router to the online billing server.
# Generated by the billing server for: {{PORTAL}}  (server IP {{PUBLICIP}})
#
# Run on the router (RouterOS 7.20+, WAN up, USB stick mounted as usb1):
#   :global tskey "tskey-auth-XXXXXXXX"
#   /tool/fetch url="{{PORTAL}}/routeros/remote.rsc" dst-path=ftn-remote.rsc
#   /import ftn-remote.rsc
#
# It is safe to run again. What it does:
#   1. Starts a Tailscale container (172.17.0.3) so the billing server can reach
#      this router's REST API at 172.17.0.1:8081 with no public IP on the router.
#   2. Points the hotspot login pages at the online portal and whitelists it.
#   3. Sends NetFlow (usage per service) to the billing server.
#   4. Stops the local ispbill container so only one billing server manages
#      the hotspot users.

:global tskey
:if ([:len $tskey] < 20) do={ :error "Set your Tailscale auth key first:  :global tskey \"tskey-auth-...\"" }

:put "1/6 container network for Tailscale"
:if ([:len [/interface/veth/find where name="veth-tailscale"]] = 0) do={
  /interface/veth add name=veth-tailscale address=172.17.0.3/24 gateway=172.17.0.1 comment="tailscale container"
}
:if ([:len [/interface/bridge/port/find where interface="veth-tailscale"]] = 0) do={
  /interface/bridge/port add bridge=br-containers interface=veth-tailscale
}

:put "2/6 firewall: REST API reachable from the Tailscale container only"
:foreach a in={"172.17.0.2";"172.17.0.3"} do={
  :if ([:len [/ip/firewall/address-list/find where list="ispbill-api" and address=$a]] = 0) do={
    /ip/firewall/address-list add list=ispbill-api address=$a comment="may use the REST API"
  }
}
/ip/firewall/filter remove [find where comment="ispbill: REST only from the container"]
/ip/firewall/filter remove [find where comment="ftn: tailscale -> REST API"]
/ip/firewall/filter add chain=input action=accept src-address=172.17.0.3 protocol=tcp dst-port=8081 place-before=0 comment="ftn: tailscale -> REST API"
/ip/firewall/filter add chain=input action=drop in-interface=br-containers protocol=tcp dst-port=8081 src-address-list=!ispbill-api place-before=1 comment="ispbill: REST only from the container"

:put "3/6 Tailscale container (pulls tailscale/tailscale from Docker Hub, ~1-3 min)"
/container/config/set registry-url=https://registry-1.docker.io tmpdir=usb1/tmp
/container/envs/remove [find where list="tailscale"]
/container/envs/add list=tailscale key=TS_AUTHKEY value=$tskey
/container/envs/add list=tailscale key=TS_HOSTNAME value="ftn-router"
/container/envs/add list=tailscale key=TS_ROUTES value="172.17.0.1/32"
/container/envs/add list=tailscale key=TS_STATE_DIR value="/var/lib/tailscale"
/container/envs/add list=tailscale key=TS_USERSPACE value="true"
/container/envs/add list=tailscale key=TS_ACCEPT_DNS value="false"
/container/envs/add list=tailscale key=PATH value="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
:do { /container/mounts add name=tailscale-state src=usb1/tailscale-state dst=/var/lib/tailscale } on-error={
  :do { /container/mounts add list=tailscale-state src=usb1/tailscale-state dst=/var/lib/tailscale } on-error={ :put "   (mount tailscale-state already exists)" }
}
:if ([:len [/container/find where comment="tailscale"]] = 0) do={
  /container/add remote-image=tailscale/tailscale:stable interface=veth-tailscale envlists=tailscale mounts=tailscale-state root-dir=usb1/tailscale-root hostname=ftn-router dns=172.17.0.1 logging=yes start-on-boot=yes comment="tailscale"
}
:put "   waiting for the image to download and extract, then starting it"
:local started false
:local tries 0
:while ((!$started) and ($tries < 72)) do={
  :delay 5s
  :set tries ($tries + 1)
  :do { /container/start [find where comment="tailscale"]; :set started true } on-error={}
}
:if (!$started) do={ :put "   not started yet: check /container/print, then /container/start [find comment=tailscale]" }

:put "4/6 hotspot pages -> {{PORTAL}}"
:local dir [/ip/hotspot/profile/get [find where name="ispbill-hsprof"] html-directory]
:foreach f in={"login.html";"alogin.html";"status.html";"logout.html";"rlogin.html";"error.html"} do={
  /tool/fetch url=("{{PORTAL}}/routeros/hotspot/" . $f) dst-path=($dir . "/" . $f) output=file
}
/ip/hotspot/walled-garden/ip remove [find where comment="ftn: online portal"]
/ip/hotspot/walled-garden/ip add action=accept dst-address={{PUBLICIP}} comment="ftn: online portal"

:put "5/6 NetFlow -> {{PUBLICIP}}:2055"
/ip/traffic-flow/target remove [find where comment="ispbill metrics"]
/ip/traffic-flow/target add dst-address={{PUBLICIP}} port=2055 version=5 comment="ispbill metrics"

:put "6/6 stopping the local billing container"
:if ([:len [/container/find where comment="ispbill"]] > 0) do={
  /container/set [find where comment="ispbill"] start-on-boot=no
  :do { /container/stop [find where comment="ispbill"] } on-error={}
}

:set tskey ""
:put "Done. In the Tailscale admin console: approve the 172.17.0.1/32 route for ftn-router"
:put "and turn off key expiry for it. Then check {{PORTAL}}/healthz shows router_ok:true."
