<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws all UI; AppCompat is the host theme because androidx.biometric's pre-28 dialog needs it. -->
    <style name="Theme.FtnAdmin" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ftn_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Launcher activity theme: system splash with the adaptive icon, then switches to Theme.FtnAdmin. -->
    <style name="Theme.FtnAdmin.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ftn_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ftn_brand_dark</item>
        <item name="postSplashScreenTheme">@style/Theme.FtnAdmin</item>
    </style>
</resources>
